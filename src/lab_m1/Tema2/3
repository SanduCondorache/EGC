bool BlockWorld::checkBlocksUnderIsRiver(int x, int z) {

    for (int y = 0; y < WORLD_HEIGHT; y++) {
        if (blocks[x][y][z] == -1) {
            return true;
        }
    }

    return false;
}
bool BlockWorld::checkBlockAboveExists(int x, int z) {
    int h = heights[x][z];
    if (train[x][z] == 1) {
        cout << blocks[x][heights[x][z] + 1][z] << endl;
    }
    for (int y = h; y < WORLD_HEIGHT; y++) {
        if (blocks[x][y][z] == 1) {
            return true;
        }
    }

    return false;
}
