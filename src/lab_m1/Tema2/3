bool BlockWorld::CheckBlockExists(int x, int y, int z) {
    if (x < 0 || x >= WORLD_WIDTH || y < 0 || y >= WORLD_HEIGHT || z < 0 ||
        z >= WORLD_DEPTH) {
        return false;
    }

    return blocks[x][y][z] != 0;
}

void BlockWorld::AddCubeFace(std::vector<VertexFormat> &vertices, float x,
                             float y, float z, int face, int type) {

    glm::vec3 color;
    glm::vec3 normal;
    glm::vec3 positions[6];

    switch (face) {
    case 0:
        positions[0] = glm::vec3(x, y + 1, z);
        positions[1] = glm::vec3(x + 1, y + 1, z);
        positions[2] = glm::vec3(x + 1, y + 1, z + 1);
        positions[3] = glm::vec3(x, y + 1, z);
        positions[4] = glm::vec3(x + 1, y + 1, z + 1);
        positions[5] = glm::vec3(x, y + 1, z + 1);
        break;
    case 1:
        positions[0] = glm::vec3(x, y, z + 1);
        positions[1] = glm::vec3(x + 1, y, z + 1);
        positions[2] = glm::vec3(x + 1, y, z);
        positions[3] = glm::vec3(x, y, z + 1);
        positions[4] = glm::vec3(x + 1, y, z);
        positions[5] = glm::vec3(x, y, z);
        break;
    case 2:
        positions[0] = glm::vec3(x, y, z + 1);
        positions[1] = glm::vec3(x + 1, y, z + 1);
        positions[2] = glm::vec3(x + 1, y + 1, z + 1);
        positions[3] = glm::vec3(x, y, z + 1);
        positions[4] = glm::vec3(x + 1, y + 1, z + 1);
        positions[5] = glm::vec3(x, y + 1, z + 1);
        break;
    case 3:
        positions[0] = glm::vec3(x + 1, y, z);
        positions[1] = glm::vec3(x, y, z);
        positions[2] = glm::vec3(x, y + 1, z);
        positions[3] = glm::vec3(x + 1, y, z);
        positions[4] = glm::vec3(x, y + 1, z);
        positions[5] = glm::vec3(x + 1, y + 1, z);
        break;
    case 4:
        positions[0] = glm::vec3(x, y, z);
        positions[1] = glm::vec3(x, y, z + 1);
        positions[2] = glm::vec3(x, y + 1, z + 1);
        positions[3] = glm::vec3(x, y, z);
        positions[4] = glm::vec3(x, y + 1, z + 1);
        positions[5] = glm::vec3(x, y + 1, z);
        break;
    case 5:
        positions[0] = glm::vec3(x + 1, y, z + 1);
        positions[1] = glm::vec3(x + 1, y, z);
        positions[2] = glm::vec3(x + 1, y + 1, z);
        positions[3] = glm::vec3(x + 1, y, z + 1);
        positions[4] = glm::vec3(x + 1, y + 1, z);
        positions[5] = glm::vec3(x + 1, y + 1, z + 1);
        break;
    }

    if (type == -1) {
        if (y <= 4)
            color = glm::vec3(0.0f, 0.3f, 1.0f);
    } else if (face == 0) {
        if (y >= 6) {
            color = glm::vec3(1, 1, 1);
            normal = glm::vec3(0, 1, 0);
        } else {
            color = glm::vec3(0.02f, 0.47f, 0.0f);
            normal = glm::vec3(0, 1, 0);
        }
    } else if (face == 1) {
        color = glm::vec3(0.3, 0.2, 0.1);
        normal = glm::vec3(0, -1, 0);
    } else {
        color = glm::vec3(0.5, 0.4, 0.2);
        if (face == 2)
            normal = glm::vec3(0, 0, 1);
        else if (face == 3)
            normal = glm::vec3(0, 0, -1);
        else if (face == 4)
            normal = glm::vec3(-1, 0, 0);
        else
            normal = glm::vec3(1, 0, 0);
    }

    for (int i = 0; i < 6; i++) {
        vertices.push_back(VertexFormat(positions[i], normal, color));
    }
}

void BlockWorld::AddRailTile(std::vector<VertexFormat> &vertices, int x, int y,
                             int z, int sw) {

    glm::vec3 p0, p1, p2, p3;
    glm::vec3 color(0.8f, 0.7f, 0.2f);
    int x1 = train[x + 1][z];
    int x2 = train[x - 1][z];
    int z1 = train[x][z + 1];
    int z2 = train[x][z - 1];

    float h = heights[x][z] + 0.01f;
    float h1 = heights[x + 1][z] + 0.01f;
    float h2 = heights[x][z + 1] + 0.01f;

    if (train[x][z] == 1) {
        h = y + 0.01f;
        if (mouintainRails[x][z]) {
            mesh.AddMeshData(dr->InitRailMx(x, h, z, color));
        } else if (riverRails[x][z]) {
            mesh.AddMeshData(dr->InitRailRiverx(x, h, z, color));
        } else {
            mesh.AddMeshData(dr->InitRail1(x, x + 1, h, z, z + 1, color));
        }
        return;
    }

    if (x2 && x1 && train[x - 1][z] == 2 && train[x + 1][z] == 2 &&
        heights[x - 1][z] > heights[x][z] &&
        heights[x + 1][z] > heights[x][z]) {

        mesh.AddMeshData(dr->InitRailVx(x, h, heights[x - 1][z],
                                        heights[x + 1][z], z, color));
        return;
    }

    if (z2 && z1 && train[x][z - 1] == 2 && train[x][z + 1] == 2 &&
        heights[x][z - 1] > heights[x][z] &&
        heights[x][z + 1] > heights[x][z]) {

        mesh.AddMeshData(dr->InitRailVz(x, h, heights[x][z - 1],
                                        heights[x][z + 1], z, color));

        return;
    }

    if (x1 == 2) {
        if (h1 > h) {
            mesh.AddMeshData(dr->InitRail2x(x, x + 1, h, h1, z, z + 1, color));
        } else if (h1 < h) {
            mesh.AddMeshData(dr->InitRail2x(x, x + 1, h, h1, z, z + 1, color));
        } else {
            if (mouintainRails[x][z]) {
                mesh.AddMeshData(dr->InitRailRiverx(x, h, z, color));
            } else if (riverRails[x][z]) {
                mesh.AddMeshData(dr->InitRailRiverx(x, h, z, color));
            } else {
                mesh.AddMeshData(dr->InitRail1(x, x + 1, h, z, z + 1, color));
            }
        }
    } else if (z1 == 2) {
        if (h2 > h) {
            mesh.AddMeshData(dr->InitRail2z(x, x + 1, h, h2, z, z + 1, color));
        } else if (h2 < h) {
            mesh.AddMeshData(dr->InitRail2z(x, x + 1, h, h2, z, z + 1, color));
        } else {
            if (mouintainRails[x][z]) {
                mesh.AddMeshData(dr->InitRailRiverx(x, h, z, color));
            } else if (riverRails[x][z]) {
                mesh.AddMeshData(dr->InitRailRiverz(x, h, z, color));
            } else {
                mesh.AddMeshData(dr->InitRail1(x, x + 1, h, z, z + 1, color));
            }
        }
    } else {
        if (mouintainRails[x][z]) {
            mesh.AddMeshData(dr->InitRailRiverx(x, h, z, color));
        } else {
            mesh.AddMeshData(dr->InitRail1(x, x + 1, h, z, z + 1, color));
        }
    }
}

void BlockWorld::GenerateMesh() {
    std::vector<VertexFormat> vertices;
    std::vector<unsigned int> indices;

    for (int x = 0; x < WORLD_WIDTH; x++) {
        for (int y = 0; y < WORLD_HEIGHT; y++) {
            for (int z = 0; z < WORLD_DEPTH; z++) {
                if (!blocks[x][y][z]) {
                    continue;
                }
                if (!CheckBlockExists(x, y + 1, z))
                    AddCubeFace(vertices, x, y, z, 0, blocks[x][y][z]);
                if (!CheckBlockExists(x, y - 1, z))
                    AddCubeFace(vertices, x, y, z, 1, blocks[x][y][z]);
                if (!CheckBlockExists(x, y, z + 1))
                    AddCubeFace(vertices, x, y, z, 2, blocks[x][y][z]);
                if (!CheckBlockExists(x, y, z - 1))
                    AddCubeFace(vertices, x, y, z, 3, blocks[x][y][z]);
                if (!CheckBlockExists(x - 1, y, z))
                    AddCubeFace(vertices, x, y, z, 4, blocks[x][y][z]);
                if (!CheckBlockExists(x + 1, y, z))
                    AddCubeFace(vertices, x, y, z, 5, blocks[x][y][z]);
            }
        }
    }

    for (int x = 0; x < WORLD_WIDTH; x++) {
        for (int z = 0; z < WORLD_DEPTH; z++) {
            if (train[x][z] != 0) {
                if (train[x][z] == 2) {
                    AddRailTile(vertices, x, heights[x][z], z, 0);
                } else if (train[x][z] == 1) {
                    AddRailTile(vertices, x, special_coords[{x, z}], z, 1);
                }
            }
        }
    }

    for (unsigned int i = 0; i < vertices.size(); i++) {
        indices.push_back(i);
    }

    mesh.AddMeshData(vertices, indices);

    terrainMesh = new Mesh("terrain");
    terrainMesh->SetDrawMode(GL_TRIANGLES);
    terrainMesh->InitFromData(mesh.vertices, mesh.indices);
}

