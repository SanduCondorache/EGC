void BlockWorld::GenerateRiver() {
    const int riverWidth = 3;
    const float noiseScale = 0.02f;

    for (int z = 0; z < WORLD_DEPTH; z++) {
        float n = perlin.noise(0, z * noiseScale, 0);
        n = (n + 1.0f) * 0.5f;
        int cx = (int)(n * (WORLD_WIDTH - 1));

        for (int dx = -riverWidth; dx <= riverWidth; dx++) {
            int x = cx + dx;

            if (x < 0 || x >= WORLD_WIDTH)
                continue;

            for (int y = 0; y < WORLD_HEIGHT; y++) {
                if (blocks[x][y][z] != 0) {
                    blocks[x][y][z] = -1;
                }

                if (abs(dx) <= 1 && y < 2) {
                    blocks[x][y][z] = -1;
                }

                if (blocks[z][y][x] != 0) {
                    blocks[z][y][x] = -1;
                }

                if (abs(dx) <= 1 && y < 2) {
                    blocks[z][y][x] = -1;
                }
            }
        }
    }

    for (int x = 0; x < WORLD_WIDTH; x++) {
        for (int z = 0; z < WORLD_DEPTH; z++) {
            for (int y = 0; y < WORLD_HEIGHT; y++) {
                if (y >= 3 && blocks[x][y][z] == -1) {
                    blocks[x][y][z] = 0;
                }
            }
        }
    }

    for (int x = 0; x < WORLD_WIDTH; x++) {
        for (int z = 0; z < WORLD_DEPTH; z++) {
            if (train[x][z] != 0) {
                if (checkBlocksUnderIsRiver(x, z)) {
                    riverRails[x][z] = 1;
                } else if (train[x][z] == 1 && checkBlockAboveExists(x, z)) {
                    cout << 1 << endl;
                    mouintainRails[x][z] = 1;
                }
            }
        }
    }
}

void BlockWorld::GenerateTerrain() {
    for (int x = 0; x < WORLD_WIDTH; x++) {
        for (int z = 0; z < WORLD_DEPTH; z++) {
            double nx = x / 16.0;
            double nz = z / 16.0;

            double height = perlin.noise(nx * 2, 0, nz * 2) * 0.5 + 0.5;
            height += perlin.noise(nx * 4, 0, nz * 4) * 0.25;
            int blockHeight = (int)(height * WORLD_HEIGHT * 0.7);

            float minimum = 3.0f;
            blockHeight = minimum + maxf(0, blockHeight - minimum);
            heights[x][z] = blockHeight + 1;

            for (int y = 0; y < WORLD_HEIGHT; y++) {
                if (y <= blockHeight) {
                    blocks[x][y][z] = 1;
                } else {
                    blocks[x][y][z] = 0;
                }
            }
        }
    }

    for (int x = 0; x < WORLD_WIDTH; x++) {
        for (int z = 0; z < WORLD_DEPTH; z++) {
            if (train[x][z] != 0) {
                if (train[x + 1][z] != 0 && heights[x + 1][z] < heights[x][z]) {
                    int start = heights[x + 1][z];
                    int end = heights[x][z];

                    for (int i = x; i <= x + 1; i++) {
                        for (int y = start; y <= end; y++) {
                            if (y >= 0 && y < WORLD_HEIGHT) {
                                blocks[i][y][z] = 0;
                            }
                        }
                    }
                }

                if (train[x][z + 1] != 0 && heights[x][z + 1] < heights[x][z]) {
                    int start = heights[x][z + 1];
                    int end = heights[x][z];

                    for (int i = z; i <= z + 1; i++) {
                        for (int y = start; y <= end; y++) {
                            if (y >= 0 && y < WORLD_HEIGHT) {
                                blocks[x][y][i] = 0;
                            }
                        }
                    }
                }
            }
        }
    }

    for (int x = 1; x < WORLD_WIDTH - 1; x++) {
        for (int z = 0; z < WORLD_DEPTH; z++) {
            if (train[x - 1][z] == 0 || train[x][z] == 0 ||
                train[x + 1][z] == 0) {
                continue;
            }

            float h = heights[x][z];
            float h1 = heights[x + 1][z];
            float h2 = heights[x - 1][z];

            if (h2 > h && h1 > h) {
                heights[x][z] = std::min(h2, h1);
            }
        }
    }

    for (int x = 0; x < WORLD_WIDTH; x++) {
        for (int z = 1; z < WORLD_DEPTH - 1; z++) {
            if (train[x][z - 1] == 0 || train[x][z] == 0 ||
                train[x][z + 1] == 0) {
                continue;
            }

            float h = heights[x][z];
            float h1 = heights[x][z + 1];
            float h2 = heights[x][z - 1];

            if (h2 > h && h1 > h) {
                heights[x][z] = std::min(h2, h1);
            }
        }
    }

    for (int x = 0; x < WORLD_WIDTH; x++) {
        for (int z = 0; z < WORLD_DEPTH; z++) {
            if (train[x][z] != 0) {
                for (int y = heights[x][z] + 1; y < WORLD_HEIGHT; y++) {
                    blocks[x][y][z] = 0;
                }
            }
        }
    }

    wg.flattenTerrain();
    wg.computeMinx(110, 125, 105);
    wg.computeMinx(70, 125, 55);
    wg.computeMinx(125, 130, 15);
    int h = special_coords[{105, 25}];

    for (int i = 25; i <= 50; i++) {
        special_coords[{105, i}] = h;
    }
    wg.computeMinz(15, 24, 125);
    wg.flattenTx(110, 125, 105);
    wg.flattenTx(70, 125, 55);
    wg.flattenTx(125, 130, 15);
    wg.flattenTx(25, 50, 105);
    wg.flattenTz(15, 25, 125);

    int x = 100, z = 50;
    int offx = 10, offz = 10;
    for (int y = 0; y < WORLD_HEIGHT; y++) {
        for (int i = 0; i < offx; i++) {
            for (int j = 0; j < offz; j++) {
                blocks[x + i][y][z + j] = 1;
            }
        }
    }

    // x = 100, z = 100;
